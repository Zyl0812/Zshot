<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starshot.Features.Screenshot.LongCapture.LongCaptureControlWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sf="using:Starshot.Frameworks"
             Title="长截图">
    <StackPanel Padding="16" Spacing="10">
        <TextBlock x:Name="StatusText" Text="请滚动页面以继续截图" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="Finish_Click" Content="完成" Style="{ThemeResource AccentButtonStyle}" />
            <Button Click="Cancel_Click" Content="取消" />
        </StackPanel>
    </StackPanel>
</sf:WindowEx>
