<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Zshot.Features.Screenshot.Editor.CaptureEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Zshot.Frameworks"
             Title="Zshot"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <canvas:CanvasControl x:Name="DrawCanvas"
                              Grid.Row="0"
                              Background="Transparent"
                              Draw="DrawCanvas_Draw"
                              PointerMoved="DrawCanvas_PointerMoved"
                              PointerPressed="DrawCanvas_PointerPressed"
                              PointerReleased="DrawCanvas_PointerReleased" />

        <Border Grid.Row="1"
                Padding="10,8"
                Background="#F21A1A1E">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="select" ToolTipService.ToolTip="选择">
                    <FontIcon FontSize="16" Glyph="&#xE8B0;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="rect" ToolTipService.ToolTip="矩形">
                    <FontIcon FontSize="16" Glyph="&#xE739;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="ellipse" ToolTipService.ToolTip="椭圆">
                    <FontIcon FontSize="16" Glyph="&#xEA3A;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="line" ToolTipService.ToolTip="直线">
                    <FontIcon FontSize="16" Glyph="&#xE76F;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="arrow" ToolTipService.ToolTip="箭头">
                    <FontIcon FontSize="16" Glyph="&#xF54E;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="pen" ToolTipService.ToolTip="画笔">
                    <FontIcon FontSize="16" Glyph="&#xED63;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="text" ToolTipService.ToolTip="文字">
                    <FontIcon FontSize="16" Glyph="&#xE8D2;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="mosaic" ToolTipService.ToolTip="马赛克">
                    <FontIcon FontSize="16" Glyph="&#xE7B3;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind SetToolCommand}" CommandParameter="number" ToolTipService.ToolTip="序号">
                    <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind UndoCommand}" ToolTipService.ToolTip="撤销">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind RedoCommand}" ToolTipService.ToolTip="重做">
                    <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind RunOcrCommand}" ToolTipService.ToolTip="OCR">
                    <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind RunTranslateCommand}" ToolTipService.ToolTip="翻译">
                    <FontIcon FontSize="16" Glyph="&#xE8C1;" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Command="{x:Bind RequestLongCaptureCommand}" ToolTipService.ToolTip="长截图">
                    <FontIcon FontSize="16" Glyph="&#xE8A4;" />
                </Button>
                <Button Height="36"
                        MinWidth="64"
                        Padding="14,0"
                        Command="{x:Bind CompleteCommand}"
                        Content="完成"
                        CornerRadius="18"
                        Style="{ThemeResource AccentButtonStyle}" />
                <Button Height="36" Padding="12,0" Command="{x:Bind CancelCommand}" Content="取消" />
            </StackPanel>
        </Border>
    </Grid>
</sf:WindowEx>
