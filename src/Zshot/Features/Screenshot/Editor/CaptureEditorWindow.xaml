<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Zshot.Features.Screenshot.Editor.CaptureEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Zshot.Frameworks"
             Title="Zshot"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <canvas:CanvasControl x:Name="DrawCanvas"
                              Grid.Row="0"
                              Background="Transparent"
                              Draw="DrawCanvas_Draw"
                              PointerMoved="DrawCanvas_PointerMoved"
                              PointerPressed="DrawCanvas_PointerPressed"
                              PointerReleased="DrawCanvas_PointerReleased" />

        <Border Grid.Row="1"
                Padding="8"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="select" Content="选择" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="rect" Content="矩形" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="ellipse" Content="椭圆" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="line" Content="直线" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="arrow" Content="箭头" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="pen" Content="画笔" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="text" Content="文字" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="mosaic" Content="马赛克" />
                <Button Command="{x:Bind SetToolCommand}" CommandParameter="number" Content="序号" />
                <Button Command="{x:Bind UndoCommand}" Content="撤销" />
                <Button Command="{x:Bind RedoCommand}" Content="重做" />
                <Button Command="{x:Bind ClearCommand}" Content="清空" />
                <Button Command="{x:Bind RunOcrCommand}" Content="OCR" />
                <Button Command="{x:Bind RunTranslateCommand}" Content="翻译" />
                <Button Command="{x:Bind RequestLongCaptureCommand}" Content="长截图" />
                <Button Command="{x:Bind CompleteCommand}" Content="完成" Style="{ThemeResource AccentButtonStyle}" />
                <Button Command="{x:Bind CancelCommand}" Content="取消" />
            </StackPanel>
        </Border>
    </Grid>
</sf:WindowEx>
