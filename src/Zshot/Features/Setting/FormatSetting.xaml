<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Zshot.Features.Setting.FormatSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Zshot.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Zshot.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer Padding="0">
        <StackPanel Padding="24,4,24,24">

            <TextBlock Margin="0,4,0,8"
                       Style="{ThemeResource GroupHeaderStyle}"
                       Text="{x:Bind lang:Lang.Zshot_GroupStorageFormat}" />

            <StackPanel Spacing="4">
                <cwc:SettingsCard Header="{x:Bind lang:Lang.Zshot_SDRFormat}">
                    <cwc:Segmented SelectedIndex="{x:Bind ScreenshotSDRFormat, Mode=TwoWay}">
                        <cwc:SegmentedItem Content="PNG" />
                        <cwc:SegmentedItem Content="AVIF" />
                        <cwc:SegmentedItem Content="JPEG XL" />
                    </cwc:Segmented>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="{x:Bind lang:Lang.Zshot_HDRFormat}">
                    <cwc:Segmented SelectedIndex="{x:Bind ScreenshotHDRFormat, Mode=TwoWay}">
                        <cwc:SegmentedItem Content="AVIF" />
                        <cwc:SegmentedItem Content="JPEG XL" />
                        <cwc:SegmentedItem Content="PNGv3" />
                    </cwc:Segmented>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="{x:Bind lang:Lang.Zshot_Quality}">
                    <cwc:Segmented SelectedIndex="{x:Bind ScreenshotQuality, Mode=TwoWay}">
                        <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_Medium}" />
                        <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_High}" />
                        <cwc:SegmentedItem Content="{x:Bind lang:Lang.ScreenshotSetting_Lossless}" />
                    </cwc:Segmented>
                </cwc:SettingsCard>
            </StackPanel>


            <TextBlock Style="{ThemeResource GroupHeaderStyle}" Text="{x:Bind lang:Lang.Zshot_GroupColor}" />

            <cwc:SettingsCard Description="{x:Bind lang:Lang.Zshot_ColorManagementDesc}"
                              Header="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}">
                <ToggleSwitch IsOn="{x:Bind EnableScreenshotColorManagement, Mode=TwoWay}" OffContent="" OnContent="" />
            </cwc:SettingsCard>


            <TextBlock Style="{ThemeResource GroupHeaderStyle}" Text="{x:Bind lang:Lang.Zshot_GroupHdr}" />

            <StackPanel Spacing="4">
                <cwc:SettingsCard Description="{x:Bind lang:Lang.Zshot_AutoConvertSDRDesc}"
                                  Header="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}">
                    <ToggleSwitch IsOn="{x:Bind AutoConvertScreenshotToSDR, Mode=TwoWay}" OffContent="" OnContent="" />
                </cwc:SettingsCard>

                <cwc:SettingsCard Description="{x:Bind lang:Lang.Zshot_DeleteHDRIfSDRDesc}"
                                  Header="{x:Bind lang:Lang.Zshot_DeleteHDRIfSDR}">
                    <ToggleSwitch IsOn="{x:Bind DeleteHDRIfSDRContent, Mode=TwoWay}" OffContent="" OnContent="" />
                </cwc:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
