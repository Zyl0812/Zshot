<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Zshot.Features.Setting.ScreenshotSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Zshot.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Zshot.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer Padding="0">
        <StackPanel Padding="20,16,24,24"
                    Spacing="16">

            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="{x:Bind lang:Lang.Zshot_Nav_Screenshot}" />


            <!--  格式与质量  -->
            <StackPanel Spacing="12">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Zshot_SDRFormat}" />
                <cwc:Segmented SelectedIndex="{x:Bind ScreenshotSDRFormat, Mode=TwoWay}">
                    <cwc:SegmentedItem Content="PNG" />
                    <cwc:SegmentedItem Content="AVIF" />
                    <cwc:SegmentedItem Content="JPEG XL" />
                </cwc:Segmented>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Zshot_HDRFormat}" />
                <cwc:Segmented SelectedIndex="{x:Bind ScreenshotHDRFormat, Mode=TwoWay}">
                    <cwc:SegmentedItem Content="AVIF" />
                    <cwc:SegmentedItem Content="JPEG XL" />
                    <cwc:SegmentedItem Content="PNGv3" />
                </cwc:Segmented>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Zshot_Quality}" />
                <cwc:Segmented SelectedIndex="{x:Bind ScreenshotQuality, Mode=TwoWay}">
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_Medium}" />
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_High}" />
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.ScreenshotSetting_Lossless}" />
                </cwc:Segmented>
            </StackPanel>

            <StackPanel Spacing="6">
                <ToggleSwitch IsOn="{x:Bind EnableScreenshotColorManagement, Mode=TwoWay}"
                              OffContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}"
                              OnContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Zshot_ColorManagementDesc}"
                           TextWrapping="Wrap" />
            </StackPanel>


            <!--  HDR 处理  -->
            <StackPanel Spacing="12">
                <ToggleSwitch IsOn="{x:Bind AutoConvertScreenshotToSDR, Mode=TwoWay}"
                              OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}"
                              OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Zshot_AutoConvertSDRDesc}"
                           TextWrapping="Wrap" />
                <ToggleSwitch IsOn="{x:Bind DeleteHDRIfSDRContent, Mode=TwoWay}"
                              OffContent="{x:Bind lang:Lang.Zshot_DeleteHDRIfSDR}"
                              OnContent="{x:Bind lang:Lang.Zshot_DeleteHDRIfSDR}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.Zshot_DeleteHDRIfSDRDesc}"
                           TextWrapping="Wrap" />
            </StackPanel>


            <!--  自动保存  -->
            <StackPanel Spacing="8">
                <ToggleSwitch IsOn="{x:Bind AutoSaveScreenshotToFile, Mode=TwoWay}"
                              OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoSaveScreenshotFile}"
                              OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoSaveScreenshotFile}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.ScreenshotSetting_AutoSaveScreenshotFileDesc}"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="16" Text="{x:Bind lang:Lang.Zshot_ScreenshotFolder}" />
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Height="40"
                            Padding="16,0,16,0"
                            BorderThickness="0"
                            Command="{x:Bind ChangeScreenshotFolderCommand}"
                            CornerRadius="8,20,20,8"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DE;" />
                            <TextBlock Text="{x:Bind lang:Lang.Zshot_Change}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Height="40"
                            Margin="16,0,0,0"
                            Padding="20,0,20,1"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"
                            Command="{x:Bind OpenScreenshotFolderCommand}"
                            CornerRadius="20">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ScreenshotFolderPath}"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>
                </Grid>
            </StackPanel>

            <!--  自动复制  -->
            <ToggleSwitch IsOn="{x:Bind AutoCopyScreenshotToClipboard, Mode=TwoWay}"
                          OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}"
                          OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}" />


            <StackPanel Spacing="8">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_Ocr}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.ScreenshotSetting_OcrWindows}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_Translation}" />
                <TextBox Header="Base URL" Text="{x:Bind TranslationBaseUrl, Mode=TwoWay}" />
                <PasswordBox x:Name="ApiKeyBox" Header="API Key" LostFocus="ApiKeyBox_LostFocus" />
                <TextBox Header="{x:Bind lang:Lang.ScreenshotSetting_Model}" Text="{x:Bind TranslationModel, Mode=TwoWay}" />
                <TextBox Header="{x:Bind lang:Lang.ScreenshotSetting_TargetLanguage}" Text="{x:Bind TranslationTargetLanguage, Mode=TwoWay}" />
                <TextBox Header="Prompt" Text="{x:Bind TranslationPrompt, Mode=TwoWay}" />
                <NumberBox Header="{x:Bind lang:Lang.ScreenshotSetting_Timeout}"
                           Value="{x:Bind TranslationTimeoutSeconds, Mode=TwoWay}"
                           Minimum="5"
                           Maximum="120"
                           SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_LongCaptureMaxHeight}" />
                <NumberBox Value="{x:Bind LongCaptureMaxHeight, Mode=TwoWay}" Minimum="1000" Maximum="16384" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <!--  捕获显示器  -->
            <StackPanel Spacing="12">
                <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Zshot_MonitorSource}" />
                <cwc:Segmented SelectedIndex="{x:Bind CaptureMonitorSource, Mode=TwoWay}">
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.Zshot_MonitorForeground}" />
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.Zshot_MonitorCursor}" />
                </cwc:Segmented>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
