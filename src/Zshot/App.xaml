<Application x:Class="Zshot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Zshot">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ThemeShadow x:Key="ThemeShadow" />

            <!--  设置页分组标题：组间距 24，标题到首张卡 8  -->
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <AcrylicBrush x:Key="CustomAcrylicBrush"
                          FallbackColor="#F52C2C2C"
                          TintColor="{ThemeResource ControlOnImageFillColorDefault}"
                          TintOpacity="0.6" />
            <AcrylicBrush x:Key="CustomOverlayAcrylicBrush"
                          FallbackColor="#F52C2C2C"
                          TintColor="{ThemeResource ControlOnImageFillColorDefault}"
                          TintOpacity="0.4" />

            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="CustomAcrylicBrush" />
            <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />

            <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="ContentDialog">
                <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
            </Style>

            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource CustomAcrylicBrush}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#0066FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#3385FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#66A3FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#99C2FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0052CC</Color>
                    <Color x:Key="SystemAccentColorDark2">#003D99</Color>
                    <Color x:Key="SystemAccentColorDark3">#002966</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#0066FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#3385FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#66A3FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#99C2FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#0052CC</Color>
                    <Color x:Key="SystemAccentColorDark2">#003D99</Color>
                    <Color x:Key="SystemAccentColorDark3">#002966</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
